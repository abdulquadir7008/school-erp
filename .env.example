# ============================================
# SUPER ADMIN (auto-created/ensured on boot)
# ============================================
SUPERADMIN_EMAIL=admin@schoolsphere.test
SUPERADMIN_PASSWORD=Admin@2024

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://schoolsphere:schoolsphere_dev_2024@localhost:5433/schoolsphere

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ============================================
# JWT
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# STORAGE (S3 / Supabase)
# ============================================
S3_ENDPOINT=https://your-s3-endpoint.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=your-bucket-name
S3_REGION=ap-south-1

# ============================================
# EMAIL
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@schoolsphere.com

# ============================================
# PAYMENTS - Razorpay
# ============================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ============================================
# PAYMENTS - Stripe
# ============================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ============================================
# AI
# ============================================
OPENAI_API_KEY=sk-xxxxxxxxxxxx
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxx

# ============================================
# SMS Provider
# ============================================
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-account-sid
SMS_AUTH_TOKEN=your-auth-token
SMS_FROM_NUMBER=+1234567890

# ============================================
# WHATSAPP
# ============================================
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages
WHATSAPP_ACCESS_TOKEN=your-access-token
