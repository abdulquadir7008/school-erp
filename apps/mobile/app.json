{
  "expo": {
    "name": "SchoolSphere",
    "slug": "schoolsphere",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolsphere.app"
    },
    "android": {
      "package": "com.schoolsphere.app",
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "scheme": "schoolsphere",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      },
      "apiUrl": "http://192.168.1.7:4000/api/v1"
    }
  }
}
